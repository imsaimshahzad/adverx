# Local development only. Copy to .env.local and fill in your Supabase project's public browser values.
# Never put service-role keys, database passwords, SMTP credentials, or private API tokens in VITE_* variables.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
